{
    "name": "blog",
    "main": "src/index.js",
    "compatibility_date": "2025-08-11",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "force-trailing-slash"
    },
    "routes": [
        {
            "pattern": "madhavajay.com/*",
            "zone_name": "madhavajay.com"
        }
    ]
}